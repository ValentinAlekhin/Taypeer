  }

  dynamic view recoverTrust {
    title 'Новый доверенный набор из читаемой копии'
    description 'Исходный файл не изменяется. Старые подписи, ключи и непринятые данные сохраняются как происхождение, без переноса полномочий.'
    taypeer.desktop -> taypeer.secretWorker 'Новый файл, пароль и ID восстановления'
    taypeer.secretWorker -> taypeer.sessions 'Проверить читаемую сессию и источник'
    taypeer.sessions -> taypeer.trust 'Создать независимый genesis с локальным управляющим'
    taypeer.sessions -> taypeer.crypto 'Новый ключ; защитить исторический ciphertext и keyring'
    taypeer.secretWorker -> taypeer.coordinator 'Передать только зашифрованный seed нового файла'
