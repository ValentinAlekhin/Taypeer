    taypeer.android <- taypeer.ffi 'Маскированные строки с БД, группой, поколением и временем изменения'
    taypeer.android -> taypeer.androidPlatform 'Активировать источник выбранного результата'
    taypeer.androidPlatform -> taypeer.sessionGuard 'Проверить живую сессию перед активацией'
    taypeer.android <- taypeer.androidPlatform 'Карточка; возврат к исходному запросу и области'
    taypeer.androidPlatform -> taypeer.sessionGuard 'Background отзывает все активные и неактивные workers'
    taypeer.android <- taypeer.sessionGuard 'Удалить все результаты и отклонять поздние ответы'
  }
  dynamic view demoEdit {
    title 'Демонстрационное подтверждение в памяти'
