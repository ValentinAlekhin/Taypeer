    taypeer.secretWorker -> taypeer.sessions 'Проверить exact snapshot и прежнюю password provenance'
    taypeer.androidBiometry -> taypeer.local 'Native version1 bounded active/pending intent; exact sync retry с тем же alias'
    taypeer.android <- taypeer.androidBiometry 'Enabled только после подтверждения записи текущего intent'
  }
