    taypeer.android -> taypeer.androidPlatform 'Показать имя файла и системный выбор места'
    taypeer.androidPlatform -> androidos 'ACTION_CREATE_DOCUMENT; обычный onStop блокирует документ'
    taypeer.androidPlatform -> taypeer.ffi 'Выбранный output для того же profile, copy и attempt'
    taypeer.ffi -> taypeer.host 'Передать output текущей попытки; отмена не ждёт provider I/O'
    taypeer.host -> taypeer.storage 'Скопировать захваченный ciphertext и проверить точную длину и fingerprint'
    taypeer.storage -> taypeer.androidPlatform 'Ограниченные блоки в выбранный output; без worker или plaintext'
    taypeer.androidPlatform -> files 'Записать только явно выбранное назначение'
    taypeer.ffi -> taypeer.androidPlatform 'finish: подтвердить flush, durability, reliable errors и close'
    taypeer.androidPlatform <- files 'Подтверждённое завершение или typed ошибка'
    taypeer.android <- taypeer.ffi 'Успех только для неотменённой актуальной попытки; рабочая копия не меняется'
  }

  dynamic view androidRecoverTrust {
    title 'Восстановление управления на Android'
    description 'Отдельный ciphertext snapshot фиксирует источник повтора. Имя входит в новый зашифрованный кандидат. Принятие требует защищённого proof и фактического закрытия прежних писателей; исходный файл и свидетельство fork сохраняются.'
