  dynamic view androidBiometricUnlock {
    title 'Android: локальная биометрическая разблокировка'
    description 'Контракт docs/android-biometry.md. Регистрация создаётся после мастер-пароля; каждый unlock аутентифицирует текущий snapshot до author callback. OS adapter — узкое расширение plaintext границы host UID, не доступ RuntimeHost к ключу. Получение ciphertext не вызывает биометрию.'
    taypeer.android -> taypeer.androidPlatform 'Выбрать зарегистрированную локальную копию; новый launch stamp'
    taypeer.androidPlatform -> taypeer.secretWorker 'Pending isolated worker и ciphertext snapshot'
    taypeer.secretWorker -> taypeer.sessions 'Проверить публичное управление и scope текущего snapshot'
    taypeer.androidPlatform -> taypeer.androidBiometry 'Fixed trusted owner: связать scope, launch и одноразовый private FD'
    taypeer.androidBiometry -> taypeer.local 'Прочитать wrapper и private alias registry без ReadKey'
    taypeer.androidBiometry -> androidos 'Новый per-use decrypt Cipher; настоящий strong CryptoObject prompt'
    taypeer.sessionGuard -> taypeer.androidBiometry 'Cancel, background или смена поколения закрывают FD'
    taypeer.androidBiometry -> taypeer.secretWorker 'Private JNI doFinal: ровно 32 байта и EOF; очистить весь scratch'
    taypeer.secretWorker -> taypeer.sessions 'Safe Native owned dup: проверить FIFO/read end и exact length/EOF без /proc'
    taypeer.secretWorker -> taypeer.sessions 'Keyed managed open: аутентифицировать exact current snapshot до author'
    taypeer.sessions -> taypeer.crypto 'Проверить текущий checkpoint и epoch существующим ReadKey'
    taypeer.secretWorker -> taypeer.androidPlatform 'Только публичный session ACK живого launch stamp'
    taypeer.android <- taypeer.androidPlatform 'Открыть актуальную сессию; отменённый ответ не возвращает экран'
  }
  dynamic view androidBiometricEnroll {
    title 'Android: включение биометрии для одной БД'
    description 'Worker provenance требует текущую password-authenticated сессию. Private capability проверяет actual KeyInfo; UI не выбирает public key для экспорта ReadKey. RSA wrapper и proof prompt остаются одним exact intent.'
    taypeer.android -> taypeer.ffi 'Явно включить для выбранной открытой копии; без SPKI'
