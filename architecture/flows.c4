// Steps show architectural interactions, not exhaustive state machines or wire protocols.
// Contract views do not establish native or security acceptance.
views 'Сценарии' {
  dynamic view androidGroupFavicons {
    title 'Явная групповая загрузка favicon на Android'
    description 'Контракт docs/runtime.md: Rust фиксирует строки и фильтры одной живой попытки; host выполняет HTTP вне worker mutex. У каждого результата отдельный durable receipt; lock отзывает оставшиеся действия, не откатывая подтверждённых соседей.'
    taypeer.android -> taypeer.ffi 'Явно подтвердить группу, подгруппы и замену существующих значков'
    taypeer.ffi -> taypeer.secretWorker 'Подготовить точный план текущей OPEN-сессии'
    taypeer.secretWorker -> taypeer.sessions 'Отобрать записи и заморозить URL и дочерние operation ID'
    taypeer.ffi <- taypeer.secretWorker 'План: пропущенные записи, отсутствие URL и точные запросы'
    taypeer.ffi -> taypeer.secretWorker 'Проверить receipt очередного запроса до сети'
    taypeer.secretWorker -> taypeer.document 'Подтверждённый exact receipt либо отказ другого intent'
    taypeer.ffi -> taypeer.iconLoader 'Только для неподтверждённой строки явно получить favicon'
    taypeer.iconLoader -> websites 'Ограниченный HTTP(S) по общей сетевой политике'
    taypeer.ffi -> taypeer.secretWorker 'Передать bounded selected stream с исходным запросом'
    taypeer.secretWorker -> taypeer.sessions 'Повторно проверить доступ, receipt, EOF и изображение'
    taypeer.sessions -> taypeer.document 'Сохранить значок и одну версию записи; обычные поля не заменять'
    taypeer.sessions -> taypeer.storage 'Надёжно опубликовать общий кандидат с blobs и receipt'
    taypeer.android <- taypeer.ffi 'Отдельные ACK, пропуски и typed ошибки; повтор exact неподтверждённых строк'
    taypeer.android <- taypeer.sessionGuard 'Lock очищает batch и не применяет поздние результаты'
  }
  dynamic view androidProtectionSettings {
    title 'Защита и лимиты БД на Android'
    description 'Контракт docs/android-policy.md: отдельные FIG-формы, реальные параметры header и расход квоты. Время успешной password KDF связано с текущим epoch; keyed open его не выдумывает. Preview калибровки не изменяет БД.'
    taypeer.android -> taypeer.ffi 'Прочитать политику, расход и параметры выбранной OPEN-БД'
    taypeer.ffi -> taypeer.secretWorker 'Одна typed команда текущего поколения'
    taypeer.secretWorker -> taypeer.sessions 'Проверить сессию и собрать согласованную числовую проекцию'
    taypeer.sessions -> taypeer.crypto 'Параметры действующего header; связанный замер password KDF'
    taypeer.android <- taypeer.ffi 'Реальные значения либо typed ошибка; без ключей/header'
    taypeer.android -> taypeer.ffi 'Явно калибровать выбранную цель'
    taypeer.secretWorker -> taypeer.sessions 'Проверить цель и актуальную сессию'
    taypeer.sessions -> taypeer.crypto 'Ограниченная неизменяющая калибровка существующего алгоритма'
    taypeer.android <- taypeer.ffi 'Измеренный preview; проверить поколение и ревизию ввода'
    taypeer.android -> taypeer.ffi 'Подтвердить exact policy, operation и нужную реаутентификацию'
    taypeer.secretWorker -> taypeer.sessions 'Общие права управляющего и administrative receipt'
    taypeer.sessions -> taypeer.core 'Проверить предметную политику'
    taypeer.sessions -> taypeer.crypto 'При новой цели подготовить существующий формат epoch'
    taypeer.sessions -> taypeer.storage 'Надёжно сохранить защищённый кандидат'
    taypeer.android <- taypeer.ffi 'Durable ACK либо exact uncertain retry'
    taypeer.android <- taypeer.sessionGuard 'Lock очищает ввод/проекции и отбрасывает поздний preview'
  }
  dynamic view androidMetadataHistory {
    title 'История групп и метаданных БД на Android'
    description 'Контракт docs/metadata-history.md: точный typed snapshot и сравнение без записи; явное восстановление сохраняет ID и одну новую версию. Retry использует прежний receipt, lock очищает снимки и preview.'
