model {
  uiTests = app 'Rust UI scenarios' {
    #partial
    technology 'Cargo; gpui-kit/test-support'
    description 'Headless AppView instances with isolated profiles; UI events drive real runtime and worker processes.'
    metadata { source 'apps/taypeer/src/desktop/testing.rs'; contract 'docs/testing.md'; evidence 'apps/taypeer/tests/ui.rs' }
  }
  testPlatform = component 'UI test platform adapters' {
    #partial
    description 'Explicit feature-gated configuration: temporary credentials, preferences, a file-picker interface, owned clipboard and lock events. Headless resources and optional Metal rendering. Never a Keychain fallback.'
    metadata { source 'apps/taypeer/crates/taypeer-desktop-platform/src/macos.rs'; contract 'docs/testing.md'; evidence 'apps/taypeer/tests/ui.rs' }
  }
  uiTests -> taypeer.desktop.ui 'Real components and event handlers'
  uiTests -> testPlatform 'Explicit isolated test configuration'
  testPlatform -> taypeer.secretWorker 'Separate test worker; real cryptography and persistence'
  uiTests -> taypeer.sync 'Two profiles; direct local protocol without public relay'
  componentChecks = app 'Component visual checks' {
    #partial
    technology 'GPUI offscreen Metal; OpenPencil CLI'
    description 'Render isolated product components with public fixtures and bundled fonts; compare paint and logical layout geometry with named FIG nodes and regions. No AppView or worker sessions.'
    metadata { source '.agents/skills/taypeer-ui-testing/scripts/compare-components.py'; contract 'docs/testing.md'; evidence 'apps/taypeer/tests/components/main.rs' }
  }
  designReference = external 'OpenPencil mockups' {
    #external
    description 'Saved editable FIG; component targets resolved by unique page, ancestor and node names.'
    metadata { source 'wireframes/taypeer.fig'; contract 'wireframes/README.md' }
  }
  componentChecks -> taypeer.desktop.presentation 'Real shared components, theme and assets'
  componentChecks -> taypeer.desktop.workspace 'Retained database component previews with public fixtures'
  componentChecks -> taypeer.desktop.preferences 'Retained settings previews with public fixtures'
  componentChecks -> taypeer.desktop.exchange 'Retained exchange previews with public fixtures'
  componentChecks -> designReference 'Read-only export of the reference'
  androidChecks = app 'Android emulator checks' {
    #partial
    technology 'Python; Android instrumentation; Compose'
    description 'ARM64 Android 12/16 and 16 KiB pages. Real JNI, Binder workers, camera and local networking. Public screen fixtures and reviewed visual baselines; hardware acceptance remains separate.'
    metadata { source 'apps/taypeer-android/qa.py'; contract 'docs/testing.md'; evidence 'apps/taypeer-android/app/src/androidTest/java/dev/taypeer' }
  }
  androidTestRelay = external 'Local TLS test relay' {
    #partial
    technology 'Iroh relay; loopback; adb reverse'
    description 'Ephemeral synthetic fixture with explicit CA and hostname verification. Debug native capability only; no public network or production TLS bypass.'
    metadata { source 'apps/taypeer-android/native/examples/public-relay-fixture.rs'; contract 'docs/testing.md' }
  }
  androidChecks -> taypeer.android 'Real Compose actions and retained screen builders'
  androidChecks -> taypeer.ffi 'Real JNI and typed commands; explicit debug test capability'
  androidChecks -> taypeer.secretWorker 'Real isolated Binder services and persistence'
  androidChecks -> taypeer.androidPlatform 'Camera, OS lifecycle, scheduling and Keystore'
  androidChecks -> androidTestRelay 'Forced local relay; exact restart and replay scenarios'
}
views 'macOS UI' {
  view uiTesting {
    title 'Headless UI testing boundaries'
    include uiTests, testPlatform, taypeer.desktop.ui, taypeer.secretWorker, taypeer.sync
    autoLayout LeftRight
  }
  view componentTesting {
    title 'Isolated component visual checks'
    include componentChecks, designReference, taypeer.desktop.presentation, taypeer.desktop.workspace, taypeer.desktop.preferences, taypeer.desktop.exchange
    autoLayout LeftRight
  }
}
views 'Android UI' {
  view androidTesting {
    title 'Android automated checks and their boundaries'
    include androidChecks, androidTestRelay, taypeer.android, taypeer.ffi, taypeer.secretWorker, taypeer.androidPlatform
    autoLayout LeftRight
  }
}
