model {
  extend taypeer.mac {
    ui = component 'Компоненты macOS UI' {
      #partial
      technology 'GPUI + GPUI Kit'
      description 'Обычный запуск: интерактивный UI по макетам. Экраны владеют вводом, фокусом и подписками.'
      metadata { source 'apps/taypeer/src/macos/ui/mod.rs'; contract 'docs/macos-ui.md' }
    }
    workspace = component 'Состояние окна' {
      #partial
      description 'Навигация, открытые файлы БД, поиск, выбор и отложенные переходы. Координирует команды независимых владельцев состояния.'
      metadata { source 'apps/taypeer/src/macos/ui/workspace.rs'; contract 'docs/macos-ui.md' }
    }
    editor = component 'Черновик UI' {
      #partial
      description 'Ввод трёх вкладок и состояние доставки правок. Подтверждённый черновик принадлежит сервису; открытые копии удаляются при блокировке.'
      metadata { source 'apps/taypeer/src/ui_state/draft.rs'; contract 'docs/macos-ui.md' }
    }
    catalog = store 'Загруженные представления UI' {
      #partial
      description 'Каталог путей, маскированные строки и выбранные детали. Не содержит полный документ и секреты закрытых сессий.'
      metadata { source 'apps/taypeer/src/ui_state/catalog.rs'; contract 'docs/macos-ui.md' }
    }
    runtime = component 'Адаптер Rust-команд' {
      #partial
      description 'Фоновые команды отдельных процессов БД. Типизированные результаты, поколения сессий и независимое закрытие доступа.'
      metadata { source 'apps/taypeer/src/backend.rs'; contract 'docs/macos-ui.md'; evidence 'crates/taypeer-runtime/src/worker/tests/presentation.rs' }
    }
    preferences = component 'Настройки оформления UI' {
      #partial
      description 'Язык, тема, масштаб текста и размеры панелей. Сохраняет существующий несекретный формат настроек.'
      metadata { source 'apps/taypeer/src/macos/ui/appearance.rs'; contract 'docs/macos-ui.md' }
    }
  }
  taypeer.mac.ui -> taypeer.mac.workspace 'События навигации и представления'
  taypeer.mac.ui -> taypeer.mac.editor 'Ввод и отображение черновика'
  taypeer.mac.workspace -> taypeer.mac.catalog 'Обновить представления актуального поколения'
  taypeer.mac.workspace -> taypeer.mac.editor 'Ввод, подтверждение и отмена'
  taypeer.mac.workspace -> taypeer.mac.runtime 'Типизированные команды и ответы'
  taypeer.mac.runtime -> taypeer.secretWorker 'Приватный IPC; отдельный процесс для БД'
  taypeer.mac.runtime -> taypeer.sessionGuard 'Активность, наблюдение и блокировка'
  taypeer.mac.ui -> taypeer.mac.preferences 'Настройки и подписка на оформление'
  taypeer.mac.preferences -> taypeer.theme 'Семантические палитры'
  taypeer.mac.preferences -> taypeer.local 'Только несекретное оформление'
}
views 'macOS UI' {
  view macosUi {
    title 'Компоненты и состояние macOS UI'
    description 'Подключение компонентов к общему runtime; UI не владеет открытым документом.'
    include taypeer.mac.*, taypeer.secretWorker, taypeer.sessionGuard, taypeer.theme, taypeer.local
    autoLayout LeftRight
  }
  dynamic view uiEdit {
    title 'Подтверждение правок macOS UI'
    taypeer.mac.ui -> taypeer.mac.workspace 'Открыть запись'
    taypeer.mac.workspace -> taypeer.mac.runtime 'Начать сервисный черновик'
    taypeer.mac.workspace -> taypeer.mac.editor 'Создать общий черновик вкладок'
    taypeer.mac.ui -> taypeer.mac.editor 'Изменить поля'
    taypeer.mac.ui -> taypeer.mac.workspace 'Подтвердить'
    taypeer.mac.workspace -> taypeer.mac.editor 'Дождаться доставки ввода и заморозить редактор'
    taypeer.mac.workspace -> taypeer.mac.runtime 'Доставить ввод и подтвердить надёжное сохранение'
    taypeer.mac.runtime -> taypeer.secretWorker 'Команды текущего поколения'
    taypeer.mac.workspace -> taypeer.mac.catalog 'Обновить после подтверждения'
    taypeer.mac.ui <- taypeer.mac.workspace 'Показать актуальное состояние'
  }
}
