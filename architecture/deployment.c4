deployment {
  mac = device 'Mac владельца' {
    technology 'macOS 15+; Apple Silicon'
    description 'Локальная dev-сборка подписывается постоянным пользовательским сертификатом для сохранения идентичности доступа к Keychain; не подпись выпуска.'
    ui = instanceOf taypeer.desktop
    sessions = instanceOf taypeer.sessions
    core = instanceOf taypeer.core
    document = instanceOf taypeer.document
    crypto = instanceOf taypeer.crypto
    storage = instanceOf taypeer.storage
    sync = instanceOf taypeer.sync
    trust = instanceOf taypeer.trust
    platform = instanceOf taypeer.macPlatform
    vault = instanceOf taypeer.vault
    local = instanceOf taypeer.local
  }
  linux = device 'Linux владельца — v1' {
    technology 'NixOS x86_64; niri / Wayland; Nix package'
    description 'Целевая приёмка. Каждая БД активирует обмен после первого ввода мастер-пароля; отдельного пароля устройства нет.'
    host = process 'Desktop host' {
      ui = instanceOf taypeer.desktop
      guard = instanceOf taypeer.sessionGuard
      coordinator = instanceOf taypeer.coordinator
      sync = instanceOf taypeer.sync
      platform = instanceOf taypeer.linuxPlatform
    }
    worker = process 'Одна разблокированная БД' {
      worker = instanceOf taypeer.secretWorker
      sessions = instanceOf taypeer.sessions
      document = instanceOf taypeer.document
      crypto = instanceOf taypeer.crypto
    }
    credentials = instanceOf taypeer.localCredentials
    state = instanceOf taypeer.localState
    vault = instanceOf taypeer.vault
  }
  windows = device 'Windows — после v1' {
    technology 'Windows; planned'
    ui = instanceOf taypeer.desktop
  }
  android = device 'Телефон владельца' {
    technology 'Android 12+; ARM64'
    host = process 'Host приложения' {
      description 'Единственный координатор файлов и network host для Activity, фоновых заданий и foreground Service; без открытого документа.'
      ui = instanceOf taypeer.android
      ffi = instanceOf taypeer.ffi
      guard = instanceOf taypeer.sessionGuard
      coordinator = instanceOf taypeer.coordinator
      storage = instanceOf taypeer.storage
      sync = instanceOf taypeer.sync
      trust = instanceOf taypeer.trust
      platform = instanceOf taypeer.androidPlatform
    }
    worker = process 'Isolated Service — одно поколение БД' {
      description 'Отдельный bindIsolatedService на сессию. Только переданные дескрипторы и приватный Binder; без каталогов приложения, сети и Keystore. Смерть host отзывает доступ.'
      worker = instanceOf taypeer.secretWorker
      ffi = instanceOf taypeer.ffi
      sessions = instanceOf taypeer.sessions
      core = instanceOf taypeer.core
      document = instanceOf taypeer.document
      crypto = instanceOf taypeer.crypto
      storage = instanceOf taypeer.storage {
        description 'Только ciphertext readers и staging через переданные дескрипторы. Публикация рабочего файла остаётся у host.'
      }
      platform = instanceOf taypeer.androidPlatform {
        description 'Владение полученными ParcelFileDescriptor и локальный Binder endpoint; без Keystore и доступа по путям.'
      }
    }
    vault = instanceOf taypeer.vault
    local = instanceOf taypeer.local
  }
  mac.sync -> android.host.sync 'P2P между установками'
}

views 'Развёртывание' {
  deployment view devices {
    title 'Два устройства — общее Rust-ядро'
    description 'Целевое размещение v1. Два экземпляра сервиса используют одно определение; схема не подтверждает готовность сборок приложения.'
    include
      mac.ui,
      mac.sessions,
      mac.core,
      mac.storage,
      mac.sync,
      mac.vault,
      android.host.ui,
      android.host.ffi,
      android.worker.sessions,
      android.worker.core,
      android.host.storage,
      android.host.sync,
      android.vault
    autoLayout TopBottom
  }
}

views 'Развёртывание' {
  deployment view desktopTargets {
    title 'Общий desktop UI — текущая и будущие платформы'
    description 'macOS реализован частично; Linux входит в v1 и требует нативной приёмки; Windows отложен.'
    include mac, linux, windows, mac.ui, linux.host.ui, windows.ui
    autoLayout LeftRight
  }
}

views 'Развёртывание' {
  deployment view androidProcesses {
    title 'Android — host и изолированные поколения БД'
    description 'Целевая граница процессов; Android runtime и файловые дескрипторы требуют отдельной приёмки.'
    include android, android.host, android.host.*, android.worker, android.worker.*, android.vault, android.local
    exclude
      android.worker.storage -> android.vault,
      android.worker.platform -> android.local
    autoLayout LeftRight
  }
}

views 'Развёртывание' {
  deployment view linuxProcesses {
    title 'Linux — host, worker и локальные credentials'
    description 'Планируемая граница полномочий; обмен ciphertext продолжается после завершения worker.'
    include linux, linux.host, linux.host.*, linux.worker, linux.worker.*, linux.credentials, linux.state, linux.vault
    autoLayout LeftRight
  }
}
