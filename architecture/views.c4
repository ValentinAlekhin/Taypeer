views 'Обзор' {
  view index {
    title 'Контекст Taypeer'
    description 'Один человек и его устройства. Вся v1 — целевая архитектура; состояние реализации показано отдельно.'
    include owner, taypeer, peer, relay, files, websites
    autoLayout LeftRight
  }
  view applications {
    title 'Приложения и общие сервисы'
    description 'Сервисы — логические ответственности, не требование создавать отдельный crate на каждый блок.'
    include
      owner,
      taypeer.mac,
      taypeer.android,
      taypeer.cli,
      taypeer.secretWorker,
      taypeer.ffi,
      taypeer.sessions,
      taypeer.core,
      taypeer.document,
      taypeer.crypto,
      taypeer.storage,
      taypeer.coordinator,
      taypeer.sync,
      taypeer.trust,
      taypeer.evolution,
      taypeer.compatibility
    autoLayout LeftRight
  }
  view platform {
    title 'Границы платформ и дополнительные функции'
    include
      taypeer.mac,
      taypeer.android,
      taypeer.ffi,
      taypeer.sessions,
      taypeer.macPlatform,
      taypeer.androidPlatform,
      macos,
      androidos,
      taypeer.theme,
      taypeer.generator,
      taypeer.iconLoader,
      taypeer.kdbx,
      files,
      websites
    autoLayout LeftRight
  }
  view storage {
    title 'Хранение и обмен'
    description 'Локальное состояние включает несколько областей защиты. Это границы ответственности, не байтовая раскладка контейнера.'
    include
      taypeer.sessions,
      taypeer.crypto,
      taypeer.document,
      taypeer.storage,
      taypeer.coordinator,
      taypeer.sync,
      taypeer.trust,
      taypeer.compatibility,
      taypeer.vault,
      taypeer.local,
      peer,
      relay
    autoLayout LeftRight
  }
  view domain of data {
    title 'Основные сущности данных'
    description 'Нормальное активное состояние. Корзина, очистка и конфликты описаны в контракте; поля типов здесь не перечисляются.'
    include *
    autoLayout TopBottom
  }
  view implementation {
    title 'Что существует в основном workspace'
    description 'macOS, Rust-правила, Automerge, файловые сессии, бинарные секции и явная загрузка иконок. Не подтверждает безопасность или готовность полной v1.'
    include taypeer.mac, taypeer.cli, taypeer.secretWorker, taypeer.coordinator, taypeer.sync, taypeer.trust, taypeer.compatibility, taypeer.generator, taypeer.iconLoader, taypeer.core, taypeer.sessions, taypeer.document, taypeer.crypto, taypeer.storage, taypeer.vault, taypeer.demo, taypeer.theme
    autoLayout LeftRight
  }
}
