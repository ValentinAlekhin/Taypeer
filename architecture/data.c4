// Conceptual entities, not Rust types or a physical file schema.
model {
  data = namespace 'Предметная модель' {
    #conceptual
    metadata { contract 'docs/data-model.md' }
    database = entity 'База данных' { #conceptual }
    group = entity 'Группа' {
      #conceptual
      description '0..1 родитель; 0..* подгрупп. Циклы и конфликты размещения определены контрактом.'
    }
    entry = entity 'Запись' { #conceptual }
    attribute = entity 'Атрибут' { #conceptual }
    attachment = entity 'Вложение' { #conceptual }
    revision = entity 'Сохранённая версия' { #conceptual }
    blob = entity 'Бинарный объект' { #conceptual }
    appearance = entity 'Оформление' { #conceptual }
    draft = entity 'Локальный черновик' { #conceptual }
    trustSet = entity 'Доверенный набор' { #conceptual }
    lifecycle = entity 'Жизненный цикл объекта' { #conceptual }
    generation = entity 'Поколение состояния' { #conceptual }
    purge = entity 'Отметка окончательной очистки' { #conceptual }
    pending = entity 'Отложенный источник' { #conceptual }
    workingCopy = entity 'Рабочая копия' { #conceptual }
  }
  data.database -> data.group '0..* групп'
  data.group -> data.entry '0..* активных записей'
  data.entry -> data.attribute '0..* атрибутов'
  data.entry -> data.attachment '0..* вложений'
  data.entry -> data.revision 'История'
  data.attachment -> data.blob 'Одно содержимое; много ссылок'
  data.revision -> data.blob 'Удерживает содержимое'
  data.entry -> data.appearance 'Иконка и явные цвета'
  data.group -> data.appearance 'Иконка группы'
  data.appearance -> data.blob 'Пользовательское изображение'
  data.draft -> data.blob 'Собственная зашифрованная копия'
  data.pending -> data.blob 'Удерживает до разбора ссылок'
  data.database -> data.trustSet 'Линии доверия'
  data.group -> data.generation 'Состояния при неизменном ID'
  data.entry -> data.generation 'Состояния при неизменном ID'
  data.generation -> data.lifecycle 'Удаление и восстановление'
  data.purge -> data.generation 'Закрывает прежнее поколение'
  data.pending -> data.generation 'Поздние исходные изменения'
  data.database -> data.workingCopy 'Локальные копии'
}
