model {
  owner = person 'Владелец' { #external }
  peer = external 'Другое устройство владельца' {
    #external
    description 'Другая установка Taypeer; связь требует одновременной доступности.'
  }
  relay = external 'Разрешённый relay' {
    #external
    description 'Маршрут обмена при разрешении пользователя; не хранилище БД.'
  }
  macos = external 'macOS' { #external }
  linuxos = external 'Linux / NixOS' { #external }
  androidos = external 'Android' { #external }
  files = external 'Выбранные файлы' { #external }
  websites = external 'Источники иконок' { #external }

  taypeer = system 'Taypeer' {
    #planned
    description 'Архитектура первой версии. Статусы и evidence относятся к разным видам доказательств.'
    metadata { contract 'spec.md' }

    desktop = app 'Desktop-приложение' {
      #partial
      technology 'Rust + GPUI + GPUI Kit'
      style { color blue; border solid }
      description 'Общий GPUI-клиент; реализация macOS и Linux с отдельной нативной приёмкой. Подключается к общему runtime через типизированный адаптер и процессы БД. Headless smoke остаётся отдельной проверкой сервиса.'
      metadata {
        source 'apps/taypeer/src/main.rs'
        evidence 'spikes/gpui-android/MACOS-2026-09-09.md'
        contract 'docs/architecture.md'
      }
    }
    android = app 'Приложение Android' {
      #partial
      technology 'Kotlin + Jetpack Compose / AndroidX'
      description 'Продуктовая сборка и генератор Compose → Rust. Документный UI и P2P ещё не подключены; spike остаётся историческим стендом.'
      metadata { source 'apps/taypeer-android/app/src/main/java/dev/taypeer/MainActivity.kt'; evidence 'apps/taypeer-android/README.md'; contract 'docs/architecture.md' }
    }
    ffi = component 'Адаптер UniFFI' {
      #partial
      technology 'Rust + UniFFI'
      description 'Типизированные команды, ограниченные представления и события с БД, поколением и ID запроса; без универсального JSON API.'
      metadata { source 'apps/taypeer-android/native/src/lib.rs'; evidence 'apps/taypeer-android/README.md'; contract 'docs/architecture.md' }
    }
    cli = app 'Командный клиент' {
      #partial
      technology 'Rust + clap + clap-repl'
      description 'Подкоманды и интерактивная сессия над общим Rust API; JSON для автоматизации, явное раскрытие секретов.'
      metadata { source 'apps/taypeer-cli/src/main.rs'; contract 'docs/core-cli.md'; evidence 'apps/taypeer-cli/tests/files.rs' }
    }
    secretWorker = component 'Процесс открытой БД' {
      #partial
      technology 'Rust; отдельный процесс'
      description 'Владеет открытым документом, ключами БД и авторским ключом. Linux передаёт host только независимую транспортную capability. Блокировка инвалидирует сессию и завершает процесс даже при ошибке черновика.'
      metadata { source 'crates/taypeer-runtime/src/lib.rs'; contract 'docs/core-cli.md'; evidence 'apps/taypeer-cli/tests/files.rs' }
    }
    sessionGuard = component 'Контроль времени жизни сессий' {
      #partial
      technology 'Rust; runtime'
      description 'Общий монотонный таймер, инвалидирование ответов и завершение процессов CLI/desktop/Android независимо от команд. AppKit и Linux-адаптер передают события ОС; нативная приёмка остаётся открытой.'
      metadata { source 'crates/taypeer-runtime/src/session/mod.rs'; contract 'docs/sessions.md'; evidence 'crates/taypeer-runtime/src/worker/tests.rs' }
    }
    host = component 'Профиль и рабочие копии' {
      #partial
      technology 'Rust; runtime'
      description 'Существующий RuntimeHost; целевой общий владелец профиля, внутреннего каталога и рабочих путей GUI/CLI/Android. Публикация регистрации следует надёжной записи.'
      metadata { source 'crates/taypeer-runtime/src/host.rs'; contract 'docs/storage.md' }
    }
    coordinator = component 'Координатор рабочей копии' {
      #partial
      style { border solid }
      technology 'Rust; host CLI/desktop/Android'
      description 'Единственный файловый writer. Сериализует зашифрованные кандидаты и приём, проверяет поколение и подтверждает только надёжную фиксацию.'
      metadata { source 'crates/taypeer-sync/src/coordinator.rs'; contract 'docs/p2p.md'; evidence 'docs/p2p-acceptance.md' }
    }
    core = component 'Ядро предметной области' {
      #partial
      technology 'Rust'
      style { color blue; border solid }
      description 'Предметные типы, адресные правки и проверки групп, записей, вложений и оформления. Без UI, ОС и Automerge.'
      metadata { source 'crates/taypeer-core/src/lib.rs'; contract 'docs/data-model.md' }
    }
    sessions = component 'Сессии и сценарии БД' {
      #partial
      style { border solid }
      technology 'Rust'
      description 'Rust-команды и поколения сессий. Целевой контракт: адресные снимки автосохранения без завершения редактора, коллекция локальных зашифрованных черновиков и безопасные повторы.'
      metadata { source 'crates/taypeer-services/src/lib.rs'; contract 'docs/architecture.md' }
    }
    document = component 'Документ и объединение' {
      #partial
      style { border solid }
      technology 'Rust + Automerge'
      description 'Automerge с исходными альтернативами и бинарными ссылками. Целевая проекция детерминирована; история охватывает записи, группы и метаданные БД. Допуск проверяет сервис.'
      metadata { source 'crates/taypeer-document/src/lib.rs'; contract 'docs/data-model.md'; evidence 'spikes/encrypted-sync/REPORT.md' }
    }
    crypto = component 'Защита содержимого' {
      #partial
      style { border solid }
      technology 'Rust; KDF: Argon2id'
      description 'Файловый срез: Argon2id и AEAD через taypeer-storage. Независимые эпохи и исторические ключи реализованы в managed-сервисе; полная приёмка защиты впереди.'
      metadata { source 'crates/taypeer-storage/src/crypto.rs'; contract 'docs/storage.md'; evidence 'spikes/encrypted-sync/REPORT.md' }
    }
    storage = component 'Хранение контейнера' {
      #partial
      style { border solid }
      technology 'Rust'
      description 'Потоковые бинарные секции и ciphertext staging через явный источник временных файлов. Атомарная запись без автобэкапов; подписанная ciphertext-очередь сохраняется до ACK.'
      metadata { source 'crates/taypeer-storage/src/file.rs'; contract 'docs/storage.md'; evidence 'spikes/encrypted-sync/REPORT.md' }
    }
    sync = component 'Зашифрованный обмен' {
      #partial
      style { border solid }
      technology 'Rust + Iroh'
      description 'Получение и пересылка, включая заблокированную БД; без ключей чтения.'
      metadata { source 'crates/taypeer-sync/src/lib.rs'; contract 'docs/p2p.md'; evidence 'docs/p2p-acceptance.md' }
    }
    trust = component 'Допуск и управление' {
      #partial
      style { border solid }
      technology 'Rust'
      description 'Проверка подписанного управления, приглашения и переходы доверия.'
      metadata { source 'crates/taypeer-trust/src/lib.rs'; contract 'docs/p2p.md'; evidence 'docs/p2p-acceptance.md' }
    }
    compatibility = component 'Совместимость формата' {
      #partial
      technology 'Rust; taypeer-core'
      description 'Подписанный дескриптор схемы и независимые возможности чтения, записи и получения. Проверка без UI, сети и секретов; не выполняет миграции.'
      metadata { source 'crates/taypeer-core/src/compatibility.rs'; contract 'docs/compatibility.md' }
    }
    evolution = component 'Эволюция и восстановление' {
      #planned
      technology 'Rust'
      description 'Будущие автоматические технические переходы схемы разблокированным управляющим; восстановление резервных снимков исключено.'
      metadata { contract 'docs/compatibility.md' }
    }
    generator = component 'Генератор секретов' {
      #partial
      technology 'Rust'
      description 'Пароли и фразы из встроенного словаря с криптографическим источником случайности.'
      metadata { source 'crates/taypeer-services/src/generator.rs'; contract 'spec.md' }
    }
    theme = component 'Тема и локальные настройки' {
      #partial
      style { border solid }
      description 'Общий источник палитр; адаптация к каждому фронтенду.'
      metadata { source 'resources/theme.toml'; contract 'spec.md#тема-интерфейса' }
    }
    iconLoader = component 'Загрузка иконок' {
      #partial
      description 'Явные HTTP(S)-запросы, проверка изображений и ограниченные ресурсы; результат входит в черновик. Локальные адреса разрешены, переход с публичного сайта внутрь сети запрещён.'
      metadata { source 'crates/taypeer-services/src/icons/mod.rs'; contract 'docs/core-cli.md'; evidence 'crates/taypeer-services/src/icons/tests.rs' }
    }
    macPlatform = component 'Адаптеры macOS' {
      #partial
      style { border solid }
      technology 'Rust + Swift / AppKit'
      description 'Credentials runtime, файловые диалоги GPUI и безоконный AppKit helper: lifecycle, защищённое копирование целого значения или выделения, подтверждение записи и очистка по владению. Биометрия пока недоступна.'
      metadata { source 'apps/taypeer/crates/taypeer-desktop-platform/src/macos.rs'; contract 'docs/architecture.md' }
    }
    linuxPlatform = component 'Адаптеры Linux' {
      #partial
      technology 'Rust; logind / ScreenSaver; Wayland data-control'
      description 'События ОС, буфер с подтверждением владения и зашифрованные credentials каждой БД; без Secret Service и пароля устройства.'
      metadata { contract 'docs/linux.md'; source 'apps/taypeer/crates/taypeer-desktop-platform/src/lib.rs' }
    }
    localCredentials = store 'Credentials каждой БД' {
      #partial
      description 'Авторский ключ и независимый LocalStateKey зашифрованы ключом эпохи БД; только локальный профиль.'
      metadata { contract 'docs/storage.md'; source 'crates/taypeer-runtime/src/profile/linux.rs'; evidence 'crates/taypeer-runtime/src/host/linux_tests.rs' }
    }
    localState = store 'Независимое локальное состояние БД' {
      #partial
      description 'LocalStateStore поверх FileStore: транспортный ключ, регистрация и контрольные отметки. Без ключей чтения и авторства.'
      metadata { contract 'docs/storage.md'; source 'crates/taypeer-runtime/src/profile/linux.rs'; evidence 'crates/taypeer-runtime/src/host/linux_tests.rs' }
    }
    androidPlatform = component 'Адаптеры Android' {
      #partial
      technology 'Kotlin + AndroidX'
      description 'SAF, Keystore, Binder и bindIsolatedService, буфер, lifecycle и фоновые задания. Контроль worker независим от команд; биометрия отложена.'
      metadata { source 'apps/taypeer-android/app/src/main/java/dev/taypeer/platform/DocumentService.kt'; evidence 'apps/taypeer-android/README.md'; contract 'docs/architecture.md' }
    }
    vault = store 'Рабочий файл .taypeer' {
      #partial
      style { border solid }
      description 'Переносимое зашифрованное состояние одной БД.'
      metadata { source 'crates/taypeer-storage/src/file.rs'; contract 'docs/data-model.md#1-границы-хранения' }
    }
    local = store 'Локальное состояние устройства' {
      #planned
      description 'Раздельное хранение приватных допусков, биометрии, коллекции зашифрованных черновиков и настроек; черновики не синхронизируются.'
      metadata { contract 'docs/data-model.md#8-локальная-модель' }
    }
    demo = store 'Демонстрационные данные в памяти' {
      #partial
      style { border solid }
      description 'Только искусственные документы и черновики на время процесса. Тестовая разблокировка не является аутентификацией; подтверждение не означает надёжную запись.'
      metadata { source 'crates/taypeer-services/src/lib.rs'; contract 'docs/architecture.md' }
    }

  }

  taypeer.desktop -> taypeer.host 'Общий профиль и внутренние рабочие копии'
  taypeer.cli -> taypeer.host 'Общий профиль; явный --profile'
  taypeer.ffi -> taypeer.host 'Внутренний каталог через платформенные файловые возможности'
  taypeer.host -> taypeer.local 'Регистрация и локальная коллекция'
  taypeer.host -> taypeer.coordinator 'Единственный ciphertext writer'
  taypeer.host -> taypeer.storage 'Надёжная публикация подготовленных файлов'
  taypeer.host -> taypeer.vault 'Рабочие пути и явный перенос'
  taypeer.desktop -> taypeer.linuxPlatform 'События ОС, буфер и диалоги'
  taypeer.cli -> taypeer.linuxPlatform 'Ленивые credentials контекстов БД'
  taypeer.linuxPlatform -> linuxos 'logind, ScreenSaver и Wayland'
  taypeer.linuxPlatform -> taypeer.sessionGuard 'Немедленно отозвать доступ при сне, блокировке или потере событий'
  taypeer.secretWorker -> taypeer.localCredentials 'Проверить и расшифровать после мастер-пароля'
  taypeer.secretWorker -> taypeer.coordinator 'Приватный IPC: независимая транспортная capability'
  taypeer.coordinator -> taypeer.localState 'Регистрация, транспорт и prepared/final markers'
  taypeer.storage -> taypeer.localCredentials 'Атомарное зашифрованное хранение эпохи'
  taypeer.storage -> taypeer.localState 'FileStore под независимым LocalStateKey'
  owner -> taypeer.desktop 'Работает с БД'
  owner -> taypeer.android 'Работает с БД'
  owner -> taypeer.cli 'Команды и интерактивная сессия'
  taypeer.cli -> taypeer.secretWorker 'Ограниченные команды через приватные каналы'
  taypeer.cli -> taypeer.sessionGuard 'Активность, политика и блокировка'
  taypeer.sessionGuard -> taypeer.secretWorker 'Закрыть доступ; ограничить сохранение черновика и завершить процесс'
  taypeer.sessionGuard -> taypeer.core 'Политика бездействия'
  taypeer.sessionGuard -> taypeer.local 'Несекретная настройка таймера'
  taypeer.coordinator -> taypeer.sessionGuard 'Инвалидировать сессию при изменении доверия'
  taypeer.cli -> taypeer.generator 'Явная генерация секрета'
  taypeer.desktop -> taypeer.generator 'Явная генерация секрета'
  taypeer.cli -> taypeer.macPlatform 'Защищённое локальное состояние и события ОС'
  taypeer.cli -> taypeer.sync 'Запуск и остановка обмена'
  taypeer.cli -> taypeer.coordinator 'Время жизни зарегистрированных рабочих копий'
  taypeer.secretWorker -> taypeer.coordinator 'Зашифрованный кандидат и ожидаемое поколение'
  taypeer.coordinator -> taypeer.storage 'Единственная надёжная фиксация файла'
  taypeer.coordinator -> taypeer.trust 'Подписи, управление и актуальность кандидата'
  taypeer.coordinator -> taypeer.local 'Профиль, сетевой ключ и отметка поколения'
  taypeer.secretWorker -> taypeer.sessions 'Последовательные команды текущей сессии'
  taypeer.secretWorker -> taypeer.document 'Открытый документ и адресные изменения'
  taypeer.secretWorker -> taypeer.crypto 'Ключи чтения и защита кандидатов'
  taypeer.secretWorker -> taypeer.macPlatform 'Авторский credential после проверки пароля'
  taypeer.desktop -> taypeer.sessions 'Переносимый headless smoke'
  taypeer.desktop -> taypeer.coordinator 'Жизненный цикл рабочих файлов через runtime'
  taypeer.android -> taypeer.ffi 'Команды и события'
  taypeer.ffi -> taypeer.sessions 'Сценарии Rust внутри isolated worker'
  taypeer.ffi -> taypeer.sessionGuard 'Поколения и независимый отзыв доступа'
  taypeer.ffi -> taypeer.coordinator 'Файлы и ciphertext независимо от разблокировки'
  taypeer.sessionGuard -> taypeer.androidPlatform 'Неблокирующее завершение isolated Service'
  taypeer.secretWorker -> taypeer.androidPlatform 'Приватный Binder и переданные дескрипторы'
  taypeer.storage -> taypeer.androidPlatform 'Источник дескрипторов для ciphertext staging в isolated worker'
  taypeer.sessions -> taypeer.core 'Правила предметной области'
  taypeer.sessions -> taypeer.document 'Правки и объединение'
  taypeer.sessions -> taypeer.crypto 'Защита содержимого'
  taypeer.sessions -> taypeer.storage 'Чтение и фиксация'
  taypeer.sessions -> taypeer.trust 'Управление БД'
  taypeer.sessions -> taypeer.evolution 'Миграция и восстановление'
  taypeer.sessions -> taypeer.compatibility 'Проверка чтения и изменений'
  taypeer.trust -> taypeer.compatibility 'Подписанный дескриптор схемы'
  taypeer.storage -> taypeer.compatibility 'Совместимость переносимого файла'
  taypeer.document -> taypeer.compatibility 'Требования модели данных'
  taypeer.sessions -> taypeer.generator 'Создание секрета'
  taypeer.sessions -> taypeer.iconLoader 'Явная загрузка'
  taypeer.sessions -> taypeer.local 'Зашифрованный черновик'
  taypeer.storage -> files 'Потоковый ввод и явный экспорт бинарных данных'
  taypeer.sessions -> taypeer.demo 'Временные документы и черновики режима demo'
  taypeer.document -> taypeer.core 'Значения и конфликты'
  taypeer.storage -> taypeer.core 'Типизированные бинарные ссылки и лимиты'
  taypeer.evolution -> taypeer.document 'Преобразование представления'
  taypeer.evolution -> taypeer.trust 'Проверка полномочий и происхождения'
  taypeer.sync -> taypeer.trust 'Проверка допуска'
  taypeer.sync -> taypeer.coordinator 'Сохранение входящих объектов и получение ciphertext'
  taypeer.sync -> taypeer.local 'Сетевые учётные данные'
  taypeer.trust -> taypeer.local 'Приватные полномочия устройства'
  taypeer.trust -> taypeer.storage 'Подписанное состояние управления'
  taypeer.storage -> taypeer.vault 'Надёжная запись и чтение'
  taypeer.iconLoader -> websites 'Запрос по действию пользователя'
  taypeer.desktop -> taypeer.macPlatform 'Файловые диалоги, буфер и события ОС'
  taypeer.android -> taypeer.androidPlatform 'Платформенные действия'
  taypeer.macPlatform -> macos 'API ОС'
  taypeer.androidPlatform -> androidos 'API ОС'
  taypeer.macPlatform -> taypeer.local 'Защита локальных данных'
  taypeer.androidPlatform -> taypeer.local 'Защита локальных данных'
  taypeer.macPlatform -> taypeer.sessionGuard 'Сон и блокировка пользовательской сессии'
  taypeer.androidPlatform -> taypeer.ffi 'Lifecycle и блокировка'
  taypeer.ffi -> taypeer.sync 'Фоновое получение'
  taypeer.macPlatform -> taypeer.sync 'Фоновое получение'
  taypeer.desktop -> taypeer.theme 'Палитра GPUI Kit'
  taypeer.android -> taypeer.theme 'Палитра Compose'
  taypeer.theme -> taypeer.local 'Выбор темы устройства'
  taypeer.sync -> peer 'Обмен зашифрованными данными' { technology 'Iroh direct' }
  taypeer.sync -> relay 'Разрешённый маршрут с проверкой TLS; возможен relay-only' { technology 'Iroh relay' }
  relay -> peer 'Передача трафика'
}
